{
  "name": "wagering-processor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1.0 <2.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "guards": "bun scripts/guards/domain-imports.ts && bun scripts/guards/money-number.ts && bun scripts/guards/integration-mocks.ts",
    "db:migrate:up": "bun scripts/db/migrate.ts up",
    "db:migrate:down": "bun scripts/db/migrate.ts down",
    "test": "bun test ./test/unit",
    "test:integration": "bun test --pass-with-no-tests ./test/integration",
    "test:concurrency": "bun test --pass-with-no-tests ./test/concurrency",
    "test:load": "bun test --pass-with-no-tests ./test/load",
    "worker:consumer": "bun src/infrastructure/workers/sqs-consumer.main.ts",
    "worker:publisher": "bun src/infrastructure/workers/outbox-publisher.main.ts",
    "worker:pending-reference": "bun src/infrastructure/workers/pending-reference.main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@nestjs/testing": "^12.5.0",
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1161.0",
    "@mikro-orm/core": "^7.2.9",
    "@mikro-orm/migrations": "^7.2.9",
    "@mikro-orm/postgresql": "^7.2.9",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
