{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.md", "!test/guards/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "parser": {
      // NestJS (stack obrigatória, AGENTS.md §1) usa decorators de parâmetro
      // (@Inject, @Body, @Param), que o parser do Biome só aceita com esta opção.
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "complexity": {
        // Desligada: conflita com noPropertyAccessFromIndexSignature do tsconfig.json.
        // Em tipos com index signature (process.env, Record<string, unknown>), o tsc
        // exige obj['chave'] (TS4111), e esta regra pede obj.chave.
        "useLiteralKeys": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
